+def evalDescribeQuery(ctx: QueryContext, query) -> Dict[str, Union[str, Graph]]:
+    """Describe resources as their Concise Bounded Description."""
+    to_describe: List[Identifier] = list(query.iris or [])
+
+    for c in evalPart(ctx, query.p):
+        for v in query.PV or []:
+            val = c.get(v)
+            if isinstance(val, (URIRef, BNode)):
+                to_describe.append(val)
+
+    graph = Graph()
+    done: Set[Identifier] = set()
+    queue = to_describe
+    while queue:
+        resource = queue.pop()
+        if resource in done:
+            continue
+        done.add(resource)
+        for s, p, o in ctx.graph.triples((resource, None, None)):
+            graph.add((s, p, o))
+            if isinstance(o, BNode):
+                queue.append(o)
+
+    res: Dict[str, Union[str, Graph]] = {}
+    res["type_"] = "DESCRIBE"
+    res["graph"] = graph
+
+    return res
+
+
 def evalQuery(graph: Graph, query: Query, initBindings, base=None):
 
     initBindings = dict((Variable(k), v) for k, v in initBindings.items())
diff --git a/test/test_sparql/test_describe.py b/test/test_sparql/test_describe.py
new file mode 100644
index 0000000..134dc3e
--- /dev/null
+++ b/test/test_sparql/test_describe.py
@@ -0,0 +1,47 @@
+from rdflib import RDF, BNode, Graph, Namespace
+
+EX = Namespace("http://www.example.org/")
+
+
+def make_graph():
+    g = Graph()
+    g.add((EX.a, RDF.type, EX.Cl))
+    b = BNode()
+    g.add((EX.a, EX.p, b))
+    g.add((b, EX.q, EX.z))
+    g.add((EX.c, EX.q, EX.z))
+    return g
+
+
+def test_describe_no_where():
+    g = make_graph()
+    r = g.query("DESCRIBE <http://www.example.org/a>")
+    assert r.type == "DESCRIBE"
+    assert len(r.graph) == 3
+    assert (EX.a, RDF.type, EX.Cl) in r.graph
+
+
+def test_describe_variable_where():
+    g = make_graph()
+    r = g.query(
+        "DESCRIBE ?s WHERE {?s ?p ?o FILTER (?s = <http://www.example.org/a>)}"
+    )
+    assert r.type == "DESCRIBE"
+    assert len(r.graph) == 3
+
+
+def test_describe_star():
+    g = make_graph()
+    r = g.query(
+        "DESCRIBE * WHERE {?s <http://www.example.org/q> <http://www.example.org/z> "
+        "FILTER(isIRI(?s))}"
+    )
+    assert len(r.graph) == 1
+    assert (EX.c, EX.q, EX.z) in r.graph
+
+
+def test_describe_iri_and_variable():
+    g = make_graph()
+    r = g.query("DESCRIBE <http://www.example.org/c> ?s WHERE {?s a ?o}")
+    assert (EX.c, EX.q, EX.z) in r.graph
+    assert (EX.a, RDF.type, EX.Cl) in r.graph
